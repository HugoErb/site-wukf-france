{
  "name": "wukf-france-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "relativize:html": "node scripts/relativize-html.js",
    "build": "npm run relativize:html && tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "dev": "npm run relativize:html && tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
