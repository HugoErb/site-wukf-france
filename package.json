{
  "name": "wukf-france-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync:partials": "node scripts/inject-partials.js",
    "build": "npm run sync:partials && tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "dev": "npm run sync:partials && tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
